    },
    {
      "name": "Search & Filters",
      "item": [
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/products/?search=phone",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "search",
                  "value": "phone",
                  "description": "Search products by name or description keyword"
                }
              ]
            },
            "description": "Search products by name or description. Uses ?search= query parameter. Searches across 'name' and 'description' fields."
          }
        },
        {
          "name": "Sort Products by Price",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/api/products/?ordering=-price",
              "host": ["{{base_url}}"],
              "path": ["api", "products", ""],
              "query": [
                {
                  "key": "ordering",
                  "value": "-price",
                  "description": "Sort by price descending. Use 'price' for ascending, '-price' for descending."
                }
              ]
            },
            "description": "Sort products by price in descending order. Use ?ordering=price for ascending, ?ordering=-price for descending. Also supports ?ordering=name."
          }
        }
      ]
    }
  ]
