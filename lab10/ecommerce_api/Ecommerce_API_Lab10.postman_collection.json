{
  "info": {
    "name": "Ecommerce API - Lab 10",
    "_postman_id": "ecommerce-api-lab10",
    "description": "Lab 10: FBV → CBV → Mixins → Generics. All endpoints are the same across all levels.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000", "type": "string" }
  ],
  "item": [
    {
      "name": "Products",
      "item": [
        {
          "name": "List All Products",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products/", "host": ["{{base_url}}"], "path": ["api","products",""] } }
        },
        {
          "name": "Create Product",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smartphone\",\n  \"description\": \"Latest model smartphone\",\n  \"price\": \"599.99\",\n  \"stock\": 50\n}" }, "url": { "raw": "{{base_url}}/api/products/", "host": ["{{base_url}}"], "path": ["api","products",""] } }
        },
        {
          "name": "Get Product by ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products/1/", "host": ["{{base_url}}"], "path": ["api","products","1",""] } }
        },
        {
          "name": "Update Product (PUT)",
          "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Smartphone Pro\",\n  \"description\": \"Updated model\",\n  \"price\": \"699.99\",\n  \"stock\": 40\n}" }, "url": { "raw": "{{base_url}}/api/products/1/", "host": ["{{base_url}}"], "path": ["api","products","1",""] } }
        },
        {
          "name": "Partial Update Product (PATCH)",
          "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"price\": \"649.99\"\n}" }, "url": { "raw": "{{base_url}}/api/products/1/", "host": ["{{base_url}}"], "path": ["api","products","1",""] } }
        },
        {
          "name": "Delete Product",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{base_url}}/api/products/1/", "host": ["{{base_url}}"], "path": ["api","products","1",""] } }
        }
      ]
    },
    {
      "name": "Categories",
      "item": [
        {
          "name": "List All Categories",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/categories/", "host": ["{{base_url}}"], "path": ["api","categories",""] } }
        },
        {
          "name": "Create Category",
          "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics\",\n  \"description\": \"Electronic devices and gadgets\"\n}" }, "url": { "raw": "{{base_url}}/api/categories/", "host": ["{{base_url}}"], "path": ["api","categories",""] } }
        },
        {
          "name": "Get Category by ID",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/categories/1/", "host": ["{{base_url}}"], "path": ["api","categories","1",""] } }
        },
        {
          "name": "Update Category (PUT)",
          "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics & Gadgets\",\n  \"description\": \"Updated description\"\n}" }, "url": { "raw": "{{base_url}}/api/categories/1/", "host": ["{{base_url}}"], "path": ["api","categories","1",""] } }
        },
        {
          "name": "Partial Update Category (PATCH)",
          "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Electronics\"\n}" }, "url": { "raw": "{{base_url}}/api/categories/1/", "host": ["{{base_url}}"], "path": ["api","categories","1",""] } }
        },
        {
          "name": "Delete Category",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{base_url}}/api/categories/1/", "host": ["{{base_url}}"], "path": ["api","categories","1",""] } }
        },
        {
          "name": "Get Products by Category",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/categories/1/products/", "host": ["{{base_url}}"], "path": ["api","categories","1","products",""] }, "description": "GET /api/categories/<id>/products/ — returns all products in a category" }
        }
      ]
    },
    {
      "name": "Search & Filters",
      "item": [
        {
          "name": "Search Products",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products/?search=phone", "host": ["{{base_url}}"], "path": ["api","products",""], "query": [{"key":"search","value":"phone"}] } }
        },
        {
          "name": "Sort Products by Price (Descending)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{base_url}}/api/products/?ordering=-price", "host": ["{{base_url}}"], "path": ["api","products",""], "query": [{"key":"ordering","value":"-price"}] } }
        }
      ]
    }
  ]
}
